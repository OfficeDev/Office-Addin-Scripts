{
  "name": "root",
  "private": true,
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24",
    "npm": ">=8 <=11"
  },
  "scripts": {
    "audit": "npm audit & npm run exec -- npm audit",
    "audit:fix": "npm audit fix & npm run exec -- npm audit fix",
    "build": "lerna run build",
    "bump-versions": "lerna version",
    "clean-install-packages": "npm run exec -- npm ci & npm ci",
    "dist-tags": "npm run exec -- npm dist-tag ls",
    "install-packages": "npm run exec -- npm install & npm install",
    "exec": "lerna exec --concurrency 1 --no-bail --no-sort --stream",
    "lint": "lerna run lint --parallel",
    "lint:fix": "lerna run lint:fix --parallel",
    "prettier": "lerna run prettier --parallel",
    "test": "lerna run test",
    "update-packages": "npm run exec -- npm update --dev"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@microsoft/m365agentstoolkit-cli": "^1.1.17",
    "@types/node": "^22.10.10",
    "eslint": "^10.0.0",
    "lerna": "^10.0.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.8.1"
  },
  "overrides": {
    "adm-zip": "^0.6.1",
    "eslint-plugin-react": {
      "eslint": "$eslint"
    },
    "eslint-plugin-react-native": {
      "eslint": "$eslint"
    },
    "lerna": {
      "handlebars": "^4.7.10",
      "js-yaml": "^4.3.2"
    },
    "nx": {
      "axios": "^1.20.0",
      "follow-redirects": "^1.16.1",
      "smol-toml": "^1.9.1"
    }
  },
  "workspaces": ["packages/*"]
}
